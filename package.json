{
  "name": "logical-expression-parser",
  "version": "2.0.0",
  "description": "Logical expression parser and evaluator, suitable for permissions management",
  "license": "MIT",
  "author": "NimitzDEV",
  "sideEffects": false,
  "keywords": [
    "ast",
    "conditional",
    "evaluator",
    "expression parser",
    "expression",
    "flags",
    "logical expression parser",
    "logical flags parser",
    "logical",
    "parser",
    "tokenizer"
  ],
  "homepage": "https://github.com/NimitzDEV/logical-expression-parser#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimitzDEV/logical-expression-parser.git"
  },
  "bugs": {
    "url": "https://github.com/NimitzDEV/logical-expression-parser/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:markers",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:markers": "node scripts/write-package-markers.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && c8 node --test test-build/test/ast.test.js test-build/test/errors.test.js test-build/test/parse.test.js && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "c8": "^10.1.3",
    "typescript": "^7.0.2"
  }
}
